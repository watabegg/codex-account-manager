#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
ACCOUNT_MANAGER="${SCRIPT_DIR}/codex-account"

if [[ ! -x "${ACCOUNT_MANAGER}" ]]; then
  echo "codex wrapper: missing account manager at ${ACCOUNT_MANAGER}" >&2
  exit 1
fi

# 明示指定は `codex --account work ...` でも使えるようにする。
if [[ "${1-}" == "--account" ]]; then
  if [[ -z "${2-}" ]]; then
    echo "codex wrapper: --account requires a name" >&2
    exit 2
  fi
  account_name="$2"
  shift 2
  exec "${ACCOUNT_MANAGER}" run --account "${account_name}" -- "$@"
fi

if [[ "${1-}" == --account=* ]]; then
  account_name="${1#--account=}"
  if [[ -z "${account_name}" ]]; then
    echo "codex wrapper: --account requires a name" >&2
    exit 2
  fi
  shift
  exec "${ACCOUNT_MANAGER}" run --account "${account_name}" -- "$@"
fi

exec "${ACCOUNT_MANAGER}" run -- "$@"
